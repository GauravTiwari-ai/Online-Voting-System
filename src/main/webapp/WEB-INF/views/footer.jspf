<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="ctx" value="${pageContext.request.contextPath}" />
<footer class="site-footer">
    <div class="footer-inner">
        <div><a class="brand footer-brand" href="${ctx}/"><span class="brand-mark" aria-hidden="true"></span> VoteSphere</a>
            <p>Your voice matters. A clearer way to make every vote count.</p></div>
        <div class="footer-links"><a href="${ctx}/polls">Available polls</a><a href="${ctx}/login">Sign in</a>
            <a href="${ctx}/register">Create account</a></div>
    </div>
    <div class="copyright">© 2026 VoteSphere. All rights reserved.</div>
</footer>
