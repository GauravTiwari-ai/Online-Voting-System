<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="ctx" value="${pageContext.request.contextPath}" />
<header class="site-header">
    <a class="brand" href="${ctx}/" aria-label="VoteSphere home"><span class="brand-mark" aria-hidden="true"></span> VoteSphere</a>
    <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false">☰</button>
    <nav class="main-nav" aria-label="Main navigation">
        <a href="${ctx}/">Home</a>
        <a href="${ctx}/polls">Available Polls</a>
        <a href="${ctx}/results">Results</a>
        <a href="${ctx}/#about">About</a>
        <c:choose>
            <c:when test="${not empty sessionScope.user}">
                <c:if test="${sessionScope.user.role eq 'ADMIN'}">
                    <a href="${ctx}/admin">Admin</a>
                    <a href="${ctx}/admin/polls">Manage polls</a>
                    <a href="${ctx}/admin/users">Users</a>
                </c:if>
                <a class="button button-outline nav-action" href="${ctx}/dashboard">Dashboard</a>
                <form class="inline-form" action="${ctx}/logout" method="post">
                    <input type="hidden" name="csrfToken" value="${requestScope.csrfToken}">
                    <button class="button button-primary nav-action" type="submit">Log out</button>
                </form>
            </c:when>
            <c:otherwise>
                <a class="button button-outline nav-action" href="${ctx}/login">Log in</a>
                <a class="button button-primary nav-action" href="${ctx}/register">Register</a>
            </c:otherwise>
        </c:choose>
    </nav>
</header>
